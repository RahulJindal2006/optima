# Copy to .env.local (or set these in the host's settings) to override the defaults.

# Where the API lives. Defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Interviews are off unless this is exactly "true".
VITE_INTERVIEWS_ENABLED=false

# The camera coach's face model (about 4 MB). Leave unset to load it from Google's public storage.
# To serve your own copy, download face_landmarker.task from Google's MediaPipe page, put it in
# public/models/ and set this to /models/face_landmarker.task
# VITE_FACE_MODEL_URL=/models/face_landmarker.task
