ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SECRET_KEY=your_random_secret_key_here
ADMIN_KEY=your_secret_admin_key_here

# Optional. Leave these out to keep the defaults.
# CLAUDE_MODEL=claude-sonnet-4-6          # the model that writes and grades
# GRADER_MODEL=                           # a different model for grading only (default: CLAUDE_MODEL)
# GRADER_SAMPLES=3                        # how many times a new answer is rated before the middle rating is kept (odd; 5 is steadier, 1 is cheapest)
# GRADER_PARALLEL=6                       # how many calls to Claude run at once while an interview is scored
# SCORING_BUDGET_SECONDS=50               # how long one scoring request works before the page asks again (1 = one step a request)
# MATCH_PRACTICE_INTERVIEWS=0             # skip scoring practice interviews against open roles
